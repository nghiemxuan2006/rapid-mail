NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://localhost:27017/rapid-mail
JWT_SECRET_KEY=your_jwt_secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://yourdomain.com/auth/microsoft/callback
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
RABBITMQ_URL=amqp://guest:guest@localhost:5672
GOOGLE_PUBSUB_TOPIC=your-pubsub-topic
GMAIL_WEBHOOK_SECRET=your-webhook-secret-token
# Open tracking: URL public mà mail client của người nhận gọi tới để tải pixel.
# Dev: dùng tunnel (ngrok/cloudflared). Để trống = tắt hẳn open tracking.
TRACKING_BASE_URL=https://yourdomain.com
TRACKING_SECRET=your-tracking-secret
